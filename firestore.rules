rules_version = '2';

// Règles de sécurité Firestore pour "Bully the Trousse".
// À coller dans la console Firebase : Firestore Database > onglet "Règles".
service cloud.firestore {
  match /databases/{database}/documents {

    // Sauvegarde de progression : chaque compte anonyme ne peut lire/écrire
    // que son propre document, identifié par son uid Firebase Auth.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Classement du monde normal : tout le monde peut lire (pour afficher le
    // classement), mais chacun ne peut écrire QUE sa propre entrée, avec des
    // valeurs plausibles (pseudo court, distance positive et raisonnable).
    // Limite : ça bloque les écritures grossières, mais un joueur qui ouvre
    // la console de son navigateur peut techniquement encore envoyer une
    // fausse distance dans les bornes autorisées — une validation complète
    // demanderait une Cloud Function côté serveur, hors scope ici.
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.pseudo is string
                   && request.resource.data.pseudo.size() <= 24
                   && request.resource.data.bestDistance is number
                   && request.resource.data.bestDistance >= 0
                   && request.resource.data.bestDistance <= 100000;
      // Retrait après récupération de partie (voir retireOldLeaderboardEntry) :
      // quand un joueur récupère sa partie sur un nouvel appareil, son ancien
      // compte garderait sinon son entrée ici, en double avec la nouvelle.
      // Le "retireToken" prouve qu'on a bien récupéré CE compte : il est
      // comparé à /recoveryTokens/{uid}, que personne ne peut lire côté client
      // (les règles, elles, y ont accès via get()). Le token n'ouvre rien
      // d'autre : il permet seulement de remettre cette entrée à 0.
      allow update: if request.auth != null
                    && request.resource.data.bestDistance == 0
                    && request.resource.data.retireToken is string
                    && exists(/databases/$(database)/documents/recoveryTokens/$(uid))
                    && get(/databases/$(database)/documents/recoveryTokens/$(uid)).data.token
                       == request.resource.data.retireToken;
    }

    // Classement du monde Plage : miroir exact de "scores" (même schéma, même
    // mécanisme de retrait via retireToken). Séparé de "scores" parce que, sur
    // la plage, tout repart de zéro (argent, améliorations, skins...) — les
    // records n'y sont pas comparables à ceux du monde normal.
    match /scoresPlage/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.pseudo is string
                   && request.resource.data.pseudo.size() <= 24
                   && request.resource.data.bestDistance is number
                   && request.resource.data.bestDistance >= 0
                   && request.resource.data.bestDistance <= 100000;
      allow update: if request.auth != null
                    && request.resource.data.bestDistance == 0
                    && request.resource.data.retireToken is string
                    && exists(/databases/$(database)/documents/recoveryTokens/$(uid))
                    && get(/databases/$(database)/documents/recoveryTokens/$(uid)).data.token
                       == request.resource.data.retireToken;
    }

    // Code de récupération : permet de retrouver sa partie (monde normal ET
    // plage, c'est le même document "users/{uid}" complet) sur un autre
    // appareil sans email ni mot de passe (voir revealRecoveryCode). L'id du
    // document EST le code secret de 16 chiffres, et le document contient une
    // copie de la sauvegarde.
    // "get" est public mais "list" est refusé : sans connaître le code exact,
    // impossible de lire quoi que ce soit (et 10^16 combinaisons rendent la
    // recherche au hasard sans espoir). Seul le propriétaire du compte pointé
    // peut écrire/écraser le document.
    match /recoveryCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Miroir du "retireToken" de chaque compte, uniquement pour que les règles
    // du classement (scores ET scoresPlage) puissent le vérifier (get() côté
    // règles fonctionne même avec "allow read: if false"). Jamais lisible par
    // un client : sinon n'importe qui pourrait retirer l'entrée de classement
    // de n'importe qui.
    match /recoveryTokens/{uid} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Statistiques publiques du système de succès (% de joueurs par succès,
    // voir la modale "Succès") : juste assez de données pour compter des
    // comptes, jamais le contenu d'une sauvegarde. Lecture publique (pour les
    // requêtes count()), chacun ne peut marquer que son propre compte.
    match /activePlayers/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /achvUnlocks/{achvId}/players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Profil public (écran Profil, système de comptes) : sous-ensemble
    // volontairement public de la sauvegarde (pseudo, avatar, skin équipé,
    // stats affichées), jamais le contenu complet de "users". "isPrivate"
    // reste lisible par tout le monde (nécessaire pour savoir s'il faut
    // afficher la banderole "compte privé" côté client) : la confidentialité
    // porte sur l'affichage du profil, pas sur ce champ lui-même.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Abonnés / abonnements : un doc par relation, id "<abonné>_<suivi>".
    // Lecture publique (comptage des abonnés/abonnements de n'importe qui),
    // chacun ne peut créer/supprimer que ses propres relations de suivi.
    match /follows/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.follower == request.auth.uid
                    && request.resource.data.following is string
                    && request.resource.data.following != request.auth.uid;
      allow delete: if request.auth != null && resource.data.follower == request.auth.uid;
    }

    // Cadeaux entre joueurs (bouton "Offrir de l'argent" sur son propre
    // profil, voir openGiftModal/sendGift) : un compte ne peut envoyer QUE
    // depuis lui-même ("from"), et seulement à quelqu'un avec qui il a une
    // relation de suivi dans un sens ou l'autre — un abonné (qui le suit) OU
    // un abonnement (qu'il suit) — vérifié via "follows", avec un montant
    // positif et plafonné. Lecture réservée à l'expéditeur et au
    // destinataire. Une fois reçu, le destinataire marque le cadeau comme vu
    // (seul "seen" est modifiable).
    // Limite : rien n'empêche un client modifié d'écrire directement ce
    // document sans avoir réellement débité "money" côté "users" (pas de
    // transaction atomique possible sans Cloud Function) — acceptable ici,
    // l'argent du jeu n'a aucune valeur réelle.
    match /gifts/{giftId} {
      allow read: if request.auth != null
                  && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.fromPseudo is string
                    && request.resource.data.fromPseudo.size() <= 24
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount <= 1000000
                    && request.resource.data.seen == false
                    && (exists(/databases/$(database)/documents/follows/$(request.resource.data.to + '_' + request.auth.uid))
                        || exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + request.resource.data.to)));
      allow update: if request.auth != null
                    && resource.data.to == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow delete: if false;
    }
  }
}
