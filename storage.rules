rules_version = '2';

// Règles de sécurité Firebase Storage pour "Bully the Trousse" (photos de
// profil). À coller dans la console Firebase : Storage > onglet "Rules".
service firebase.storage {
  match /b/{bucket}/o {

    // Photo de profil : un seul fichier par compte (toujours le même chemin,
    // chaque nouvel envoi remplace le précédent). Lecture publique (affichée
    // sur le profil, y compris pour les autres joueurs), écriture réservée au
    // propriétaire, limitée à une image de 3 Mo max (l'appli redimensionne
    // déjà côté client avant l'envoi, cette limite est un garde-fou serveur).
    match /avatars/{uid}/photo.jpg {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
